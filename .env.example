# Postgres connection string (Neon, Supabase, RDS...). Leave empty in development to use the embedded database in .data/.
DATABASE_URL=

# First run only: on an empty database the app creates this Super Admin automatically.
# Remove BOOTSTRAP_ADMIN_PASSWORD after you have signed in and changed the password.
BOOTSTRAP_ADMIN_USERNAME=
BOOTSTRAP_ADMIN_NAME=
BOOTSTRAP_ADMIN_PASSWORD=

# Optional: connections per server instance (default 5). AUTO_MIGRATE=1 applies migrations on first connection (self-hosting).
DATABASE_POOL_MAX=
AUTO_MIGRATE=

# Local demo accounts created by `npm run db:seed` all use this password (development only).
SEED_PASSWORD=change-me-for-local-dev

# Web push alerts: generate once with `npx web-push generate-vapid-keys`
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# Protects /api/cron/alerts (Vercel sends it as a Bearer token)
CRON_SECRET=
